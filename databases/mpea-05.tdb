 PAR  L(AL11MN4_HT,AL:FE,MN;0),,        +45370-62*T;,,                N 18Zhe2 !
 PAR  L(AL11MN4_HT,AL:FE,MN;1),,        +447970-345*T;,,              N 18Zhe2 !
 PAR  L(AL11MN4_HT,AL,MN:FE,MN;0),,     -1432580+1379*T;,,            N 18Zhe2 !
$
