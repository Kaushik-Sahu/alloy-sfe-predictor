$ ------------------------------------------------------------------------------
$ Cr-Mn-Ni
$
$ H.-S. Do, W.-M. Choi, B.-J. Lee, J. Mater. Sci, 57, 1373-89(2022).
$
$ Checked against paper.
$
$ Changed Cr-Ni from 92Lee to 16Tan.
$ High-sigma is removed and sigma changed from 8:4:18 to 10:4:16.
$ Ni added to second sublattice of sigma (from Ni-V).
$
$ Differences are small compared to the original 22Do, except for the removed
$ high-sigma.
$
$ 4SL model for fcc using option F.
$
$ In the paper isothermal sections at 1273, 1373 and 1473 K are shown and
$ compared with exp. data from Li et al. 2020. Comparisons with older data
$ at lower T are not made.
$
 PAR  L(LIQUID,CR,MN,NI;0),,            +40000;,,                     N 22Do !
 PAR  L(LIQUID,CR,MN,NI;1),,            +40000;,,                     N 22Do !
 PAR  L(LIQUID,CR,MN,NI;2),,            +65000;,,                     N 22Do !
$
 PAR  L(FCC_A1,CR,MN,NI:VA;0),,         +50000;,,                     N 22Do !
 PAR  L(A1_FCC,CR,MN,NI:VA;0),,         +50000;,,                     N 22Do !
$
 PAR  G(FCC_4SL,CR:CR:MN:NI:VA),,       +FCR2MNNI;,,                 N 20Hal10 !
 PAR  G(FCC_4SL,MN:MN:CR:NI:VA),,       +FCRMN2NI;,,                 N 20Hal10 !
 PAR  G(FCC_4SL,NI:NI:CR:MN:VA),,       +FCRMNNI2;,,                 N 20Hal10 !
$
 PAR  L(BCC_A2,CR,MN,NI:VA;0),,         +80000;,,                     N 22Do !
 PAR  L(A2_BCC,CR,MN,NI:VA;0),,         +80000;,,                     N 22Do !
$
 PAR  L(CBCC_A12,CR,MN,NI:VA;0),,       +50000;,,                     N 22Do !
 PAR  L(CUB_A13,CR,MN,NI:VA;0),,        +50000;,,                     N 22Do !
$
 PAR  G(SIGMA_D8B,MN:CR:NI),,           +0.3846*GSMNCRMN
             +0.6154*GSNICRNI;,,                                      N 22Do !
 PAR  G(SIGMA_D8B,MN:NI:CR),,           +10*GFCCMN+4*GBCCNI
             +16*GHSERCR;,,                                           N Lin !
 PAR  G(SIGMA_D8B,NI:CR:MN),,           +0.3846*GSNICRNI
             +0.6154*GSMNCRMN;,,                                      N 22Do !
 PAR  L(SIGMA_D8B,NI:CR:CR,MN;0),,      -85000;,,                     N 22Do !
 PAR  L(SIGMA_D8B,MN:CR:MN,NI;0),,      -600000;,,                    N 22Do !
 PAR  L(SIGMA_D8B,NI:CR:MN,NI;0),,      -600000;,,                    N 22Do !
$
$ Metastable
$
 PAR  L(HCP_A3,CR,MN,NI:VA;0),,         +50000;,,                     N 22Do !
$
 FUNCTION U1CRMNNI  298.15  +2000;                                     6000 N !
 FUNCTION U2CRMNNI  298.15  +3000;                                     6000 N !
 FUNCTION U3CRMNNI  298.15  +3000;                                     6000 N !
 FUNCTION FCR2MNNI  298.15  +2*UFCRMN+2*UFCRNI+UFMNNI+U1CRMNNI;        6000 N !
 FUNCTION FCRMN2NI  298.15  +2*UFCRMN+UFCRNI+2*UFMNNI+U2CRMNNI;        6000 N !
 FUNCTION FCRMNNI2  298.15  +UFCRMN+2*UFCRNI+2*UFMNNI+U3CRMNNI;        6000 N !
$ ------------------------------------------------------------------------------
$ Cr-Mn-V
$
$ Not yet modelled.
$
$ There seem to be no experimental data on this system. The system is
$ dominated by bcc. Sigma extends across as expected. At 1273 K high-sigma
$ extends almost to the Mn-V side with a very narrow two-phase region
$ between high-sigma and sigma. This is not surprising as high-sigma has
$ very nearly the same Gibbs energy as sigma.
$
 PAR  G(SIGMA_D8B,MN:CR:V),,            +0.2*GSMNCRCR+0.8*GSMNVV;,,   N Lin !
 PAR  G(SIGMA_D8B,MN:V:CR),,            +0.2*GSMNVV+0.8*GSMNCRCR;,,   N Lin !
 PAR  G(SIGMA_D8B,V:CR:MN),,            +10*GFCCVV+4*GHSERCR
             +16*GBCCMN;,,                                            N Lin !
$ ------------------------------------------------------------------------------
