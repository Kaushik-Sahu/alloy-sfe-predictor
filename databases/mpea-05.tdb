$
 PAR  L(CEMENTITE_D011,CR,FE:C;0),,     +14586-9.18*T;,,              N 14Khv !
$
 PAR  G(M23C6_D84,CR:FE:C),,            +0.869565*GCR23C6
             +0.130435*GFE23C6;,,                                     N 14Khv !
 PAR  G(M23C6_D84,FE:CR:C),,            +0.869565*GFE23C6
             +0.130435*GCR23C6;,,                                     N 14Khv !
