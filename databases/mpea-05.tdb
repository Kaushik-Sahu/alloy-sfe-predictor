 PAR  BMAG(FCC_A1,CR,NI:C;0),,             -1.91;,,                   N Null !
$
 PAR  L(A1_FCC,CR,NI:C;0),,             +ZERO;,,                      N 06Hal3 !
 PAR  TC(A1_FCC,CR,NI:C;0),,            -3605;,,                      N Null !
 PAR  BMAG(A1_FCC,CR,NI:C;0),,             -1.91;,,                   N Null !
$
 PAR  TC(BCC_A2,CR,NI:C;0),,            +2373;,,                      N Null !
 PAR  TC(BCC_A2,CR,NI:C;1),,             +617;,,                      N Null !
 PAR  BMAG(BCC_A2,CR,NI:C;0),,             +4;,,                      N Null !
$
 PAR  TC(A2_BCC,CR,NI:C;0),,            +2373;,,                      N Null !
 PAR  TC(A2_BCC,CR,NI:C;1),,             +617;,,                      N Null !
 PAR  BMAG(A2_BCC,CR,NI:C;0),,             +4;,,                      N Null !
$
 PAR  G(M23C6_D84,CR:NI:C),,            +0.8695652*GCR23C6
             +0.1304348*GNI23C6;,,                                    N 92Lee1 !
 PAR  G(M23C6_D84,NI:CR:C),,            +0.8695652*GNI23C6
             +0.1304348*GCR23C6;,,                                    N 92Lee1 !
 PAR  L(M23C6_D84,CR,NI:CR:C;0),,       +ZERO;,,                      N 06Hal3 !
 PAR  L(M23C6_D84,CR,NI:NI:C;0),,       +ZERO;,,                      N 06Hal3 !
$
 PAR  L(M7C3_D101,CR,NI:C;0),,          +ZERO;,,                      N 06Hal3 !
$
$ Metastable
$
 PAR  L(CEMENTITE_D011,CR,NI:C;0),,     +27898;,,                     N Null !
$ ------------------------------------------------------------------------------
$ Cr-Ni-V
$
$ W.-M. Choi, Y.H. Jo, D.G. Kim, S.S. Sohn, S. Lee, B.-J. Lee,
$ J. Phase Equilib. Diffus., 39, 694-701(2018).
$
$ Checked against paper and author's tdb (from 19Cho).
$
$ Sigma changed from 8:4:18 to 10:4:16.
$ Ni included on the 2nd sl in sigma --> several new parameters.
$ Added fcc and bcc ordering.
$ Cr-Ni changed from 92Lee to 16Tan.
$ Ni-V changed from 98Kor to 19Noo.
$
$ The new Ni-V causes large changes in the ternary. It was necessary to
$ increase the Cr-V interaction for the sigma phase to have a correct
$ extension into the ternary. The extension is less than in 18Cho, but in
$ better agreement with the experimental data from Kodentzov et al. 1987.
$ Overall the agreement is somewhat better. However, there is a strange
$ increase in the width of the fcc + bcc phase field when adding V to Cr-Ni,
$ which is not present in 18Cho. There are no experiments to support one or
$ the other. The direction of the fcc + bcc tielines (paralell to Cr-Ni) is
$ better in the present version.
$
 PAR  G(FCC_4SL,CR:CR:NI:V:VA),,        +FCR2NIV;,,                   N Lin !
 PAR  G(FCC_4SL,NI:NI:CR:V:VA),,        +FCRNI2V;,,                   N Lin !
 PAR  G(FCC_4SL,V:V:CR:NI:VA),,         +FCRNIV2;,,                   N Lin !
$
 PAR  G(SIGMA_D8B,NI:CR:V),,            +0.2*GSNICRCR+0.8*GSNIVV;,,   N 18Cho !
 PAR  G(SIGMA_D8B,NI:V:CR),,            +0.2*GSNIVV+0.8*GSNICRCR;,,   N 18Cho !
 PAR  G(SIGMA_D8B,V:CR:NI),,            +10*GHSERVV+4*GHSERCR
             +16*GHSERNI;,,                                           N Lin !
 PAR  G(SIGMA_D8B,V:NI:CR),,            +10*GHSERVV+4*GHSERNI
             +16*GHSERCR;,,                                           N Lin !
$PAR  L(SIGMA_D8B,NI:CR,V:CR;0),,       -60000;,,                     N 18Cho !
$PAR  L(SIGMA_D8B,NI:CR,V:NI;0),,       -60000;,,                     N 18Cho !
$PAR  L(SIGMA_D8B,NI:CR,V:V;0),,        -60000;,,                     N 18Cho !
 PAR  L(SIGMA_D8B,NI:CR,V:CR;0),,       -120000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,NI:CR,V:NI;0),,       -120000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,NI:CR,V:V;0),,        -120000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,V:CR,V:NI;0),,        -120000;,,                    N 21Hal6 !
$PAR  L(SIGMA_D8B,NI:CR:CR,V;0),,       -250000;,,                    N 18Cho !
$PAR  L(SIGMA_D8B,NI:V:CR,V;0),,        -250000;,,                    N 18Cho !
 PAR  L(SIGMA_D8B,NI:CR:CR,V;0),,       -310000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,NI:NI:CR,V;0),,       -310000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,NI:V:CR,V;0),,        -310000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,V:NI:CR,V;0),,        -310000;,,                    N 21Hal6 !
 PAR  L(SIGMA_D8B,NI,V:CR:CR;0),,       -337046+240.54*T;,,           N 19Noo !
 PAR  L(SIGMA_D8B,NI,V:CR:NI;0),,       -337046+240.54*T;,,           N 19Noo !
 PAR  L(SIGMA_D8B,NI,V:CR:V;0),,        -337046+240.54*T;,,           N 19Noo !
 PAR  L(SIGMA_D8B,NI,V:NI:CR;0),,       -337046+240.54*T;,,           N 19Noo !
 PAR  L(SIGMA_D8B,NI,V:V:CR;0),,        -337046+240.54*T;,,           N 19Noo !
 PAR  L(SIGMA_D8B,NI:CR:NI,V;0),,       -643900;,,                    N 19Noo !
 PAR  L(SIGMA_D8B,V:CR:NI,V;0),,        -643900;,,                    N 19Noo !
$
 FUNCTION U1CRNIV   298.15  0.0;                                       6000 N !
 FUNCTION U2CRNIV   298.15  0.0;                                       6000 N !
 FUNCTION U3CRNIV   298.15  0.0;                                       6000 N !
 FUNCTION FCRNIV2   298.15  +UFCRNI+2*UFCRV+2*UFNIV+U1CRNIV;           6000 N !
 FUNCTION FCRNI2V   298.15  +2*UFCRNI+UFCRV+2*UFNIV+U2CRNIV;           6000 N !
 FUNCTION FCR2NIV   298.15  +2*UFCRNI+2*UFCRV+UFNIV+U3CRNIV;           6000 N !
