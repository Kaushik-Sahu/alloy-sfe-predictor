 PAR  L(M23C6_D84,FE:CR,FE:C;1),,       -6540;,,                      N 14Khv !
$
 PAR  L(M7C3_D101,CR,FE:C;0),,          +81940-61.86*T;,,             N 14Khv !
 PAR  L(M7C3_D101,CR,FE:C;1),,          -7310;,,                      N 14Khv !
