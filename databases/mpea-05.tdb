 PAR  L(M7C3_D101,FE,NI:C;0),,          +68600;,,                     N 91Lee !
$ ------------------------------------------------------------------------------
$ Fe-Ni-V
$
$ W.-M. Choi, Y.H. Jo, D.G. Kim, S.S. Sohn, S. Lee, B.-J. Lee,
$ J. Phase Equilib. Diffus., 39, 694-701(2018).
$
$ Note!! Needs to be rechecked with Fe-Ni from 10Cac.
$
$ Checked against paper and author's tdb (from 19Cho).
$
$ Sigma changed from 8:4:18 to 10:4:16.
$ Ni included on the 2nd sl in sigma --> several new parameters.
$ Added fcc and bcc ordering.
$ Fe-Ni changed from 85Xin to 03Dup (modifications).
$ Ni-V changed from 98Kor to 19Noo.
$
$ It was necessary to stabilise the sigma phase considerable. The results are
$ then quite reasonable. The Fe solubility in Ni3V is possibly too high,
$ but can easily be reduced.
$
$ Solubility of Fe in Ni3V added in 19Cho.
$
 PAR  L(LIQUID,FE,NI,V;0),,             +20000;,,                     N 18Cho !
$
 PAR  G(FCC_4SL,FE:FE:NI:V:VA),,        +FFE2NIV;,,                   N Lin !
 PAR  G(FCC_4SL,NI:NI:FE:V:VA),,        +FFENI2V;,,                   N Lin !
 PAR  G(FCC_4SL,V:V:FE:NI:VA),,         +FFENIV2;,,                   N Lin !
$
 PAR  L(BCC_A2,FE,NI,V:VA;0),,          +2000;,,                      N 18Cho !
 PAR  L(A2_BCC,FE,NI,V:VA;0),,          +2000;,,                      N 18Cho !
$
 PAR  G(SIGMA_D8B,FE:NI:V),,            +10*GFCCFE+4*GBCCNI
             +16*GHSERVV;,,                                           N Lin !
 PAR  G(SIGMA_D8B,FE:V:NI),,            +0.3846*GSFEVFE
             +0.6154*GSNIVNI;,,                                       N 18Cho !
 PAR  G(SIGMA_D8B,NI:V:FE),,            +0.3846*GSNIVNI
             +0.6154*GSFEVFE;,,                                       N 18Cho !
 PAR  G(SIGMA_D8B,V:NI:FE),,            +10*GFCCVV+4*GBCCNI
             +16*GHSERFE;,,                                           N Lin !
$PAR  L(SIGMA_D8B,FE,NI:V:FE;0),,       +126760-120*T;,,              N 18Cho !
$PAR  L(SIGMA_D8B,FE,NI:V:NI;0),,       +126760-120*T;,,              N 18Cho !
$PAR  L(SIGMA_D8B,FE,NI:V:V;0),,        +126760-120*T;,,              N 18Cho !
 PAR  L(SIGMA_D8B,FE,NI:V:FE;0),,       +60000-120*T;,,               N 21Hal7 !
 PAR  L(SIGMA_D8B,FE,NI:V:NI;0),,       +60000-120*T;,,               N 21Hal7 !
 PAR  L(SIGMA_D8B,FE,NI:V:V;0),,        +60000-120*T;,,               N 21Hal7 !
$PAR  L(SIGMA_D8B,FE:V:FE,NI,V;0),,     -300000;,,                    N 18Cho !
$PAR  L(SIGMA_D8B,NI:V:FE,NI,V;0),,     -300000;,,                    N 18Cho !
 PAR  L(SIGMA_D8B,FE:V:FE,NI,V;0),,     -600000;,,                    N 21Hal7 !
 PAR  L(SIGMA_D8B,NI:V:FE,NI,V;0),,     -600000;,,                    N 21Hal7 !
 PAR  L(SIGMA_D8B,V:V:FE,NI,V;0),,      -600000;,,                    N 21Hal7 !
$
 FUNCTION U1FENIV   298.15  0.0;                                       6000 N !
 FUNCTION U2FENIV   298.15  0.0;                                       6000 N !
 FUNCTION U3FENIV   298.15  0.0;                                       6000 N !
 FUNCTION FFENIV2   298.15  +UFFENI+2*UFFEV+2*UFNIV+U1FENIV;           6000 N !
 FUNCTION FFENI2V   298.15  +2*UFFENI+UFFEV+2*UFNIV+U2FENIV;           6000 N !
 FUNCTION FFE2NIV   298.15  +2*UFFENI+2*UFFEV+UFNIV+U3FENIV;           6000 N !
$ ------------------------------------------------------------------------------
$ Fe-V-C
$
$ W. Huang, Z. Metallkd., 82, 391-401(1991).
$
$ Checked against paper.
$
$ V-C changed from 91Hua to 20Hua (minor modification of 91Hua).
$ This changes the liquidus at high temperature somewhat. Not included
$ in the 91Hua ternary dataset.
$
$ In the original assessment V3C2 is modelled without Fe solubility.
$ Cementite (V3C) was modified in 91Fer2 and used in 91Hua4.
$
 PAR  L(LIQUID,C,FE,V;0),,              -60000;,,                     N 91Hua2 !
 PAR  L(LIQUID,C,FE,V;1),,              -60000;,,                     N 91Hua2 !
 PAR  L(LIQUID,C,FE,V;2),,              +100000;,,                    N 91Hua2 !
$
 PAR  L(FCC_A1,FE,V:C;0),,              -7645.5-2.069*T;,,            N 91Hua2 !
 PAR  L(FCC_A1,FE,V:C;1),,              -7645.5-2.069*T;,,            N 91Hua2 !
 PAR  L(FCC_A1,FE,V:C,VA;0),,           -40000;,,                     N 91Hua2 !
$
 PAR  L(A1_FCC,FE,V:C;0),,              -7645.5-2.069*T;,,            N 91Hua2 !
 PAR  L(A1_FCC,FE,V:C;1),,              -7645.5-2.069*T;,,            N 91Hua2 !
 PAR  L(A1_FCC,FE,V:C,VA;0),,           -40000;,,                     N 91Hua2 !
$
 PAR  L(BCC_A2,FE,V:C;0),,              -23674+0.465*T;,,             N 91Hua2 !
 PAR  L(BCC_A2,FE,V:C;1),,              +8283;,,                      N 91Hua2 !
$
 PAR  L(A2_BCC,FE,V:C;0),,              -23674+0.465*T;,,             N 91Hua2 !
 PAR  L(A2_BCC,FE,V:C;1),,              +8283;,,                      N 91Hua2 !
$
 PAR  L(HCP_A3,FE,V:C;0),,              -15291-4.138*T;,,             N 91Hua2 !
$
$PAR  L(CEMENTITE_D011,FE,V:C;0),,      -45657-12.414*T;,,            N 91Hua2 !
 PAR  L(CEMENTITE_D011,FE,V:C;0),,      -45873-12.414*T;,,            N 91Hua4 !
$
$ Metastable
$
 PAR  G(M23C6_D84,FE:V:C),,             +0.869565*GFE23C6
             +0.130435*GV23C6;,,                                      N 91Hua4 !
 PAR  G(M23C6_D84,V:FE:C),,             +0.869565*GV23C6
             +0.130435*GFE23C6;,,                                     N 91Hua4 !
$ ------------------------------------------------------------------------------
$ Mn-Ni-C
$
$ Not yet modelled.
$
$
$ Metastable
$
 PAR  G(KAPPA_E21,MN:NI:C),,            +GFCCMN+3*GHSERNI+GHSERCC;,,  N Lin !
$
 PAR  G(M23C6_D84,MN:NI:C),,            +0.8695652*GMN23C6
             +0.1304348*GNI23C6;,,                                    N Lin !
 PAR  G(M23C6_D84,NI:MN:C),,            +0.8695652*GNI23C6
             +0.1304348*GMN23C6;,,                                    N Lin !
$ ------------------------------------------------------------------------------
$ Mn-Ni-V
$
$ Not yet modelled.
$
$ Sigma should extend across the system at 1223 K, but it does not. Instead
$ there are large regions of cbcc-A12 and cub-A13 which should not be present
$ according to Slyusarenko 1997.
$
 PAR  G(SIGMA_D8B,MN:V:NI),,            +0.3846*GSMNVMN
             +0.6154*GSNIVNI;,,                                       N Lin !
 PAR  G(SIGMA_D8B,MN:NI:V),,            +10*GFCCMN+4*GBCCNI
             +16*GHSERVV;,,                                           N Lin !
 PAR  G(SIGMA_D8B,NI:V:MN),,            +0.3846*GSNIVNI
             +0.6154*GSMNVMN;,,                                       N Lin !
 PAR  G(SIGMA_D8B,V:NI:MN),,            +10*GFCCVV+4*GBCCNI
             +16*GBCCMN;,,                                            N Lin !
$ ------------------------------------------------------------------------------
$ Mn-V-C
$
$ A. Fernandez Guillermet, W. Huang, Int. J. Thermophys., 12, 1077-1102(1991).
$
$ Checked against paper.
$
$ Using Mn-C from 10Dju instead of 90Hua.
$ Mn-C further changed to 18Tan (modfied fcc). This leads to decreased Mn
$ solubility in VC. Not included in the 91Fer ternary dataset.
$ Changed V-C from 91Hua to 20Hua changes the liquidus somewhat.
$
$ The Mn solubility in VC is slightly higher and the Mn solubility in V3C2 is
$ slightly lower than in the original 91Fer dataset. Liquidus temperatures
$ are somewhat lower (at least in the Mn-rich corner). There are no
$ experimental to support one or the other.
$
 PAR  L(BCC_A2,MN,V:C;0),,              -10000;,,                     N 91Fer2 !
 PAR  L(A2_BCC,MN,V:C;0),,              -10000;,,                     N 91Fer2 !
 PAR  L(CBCC_A12,MN,V:C;0),,            -22225.2;,,                   N 91Hua4 !
 PAR  L(CUB_A13,MN,V:C;0),,             -17724;,,                     N 91Hua4 !
$
 PAR  G(M23C6_D84,MN:V:C),,             +0.869565*GMN23C6
             +0.130435*GV23C6;,,                                      N 91Fer2 !
 PAR  G(M23C6_D84,V:MN:C),,             +0.869565*GV23C6
             +0.130435*GMN23C6;,,                                     N 91Fer2 !
$ ------------------------------------------------------------------------------
$ Ni-V-C
$
$ B. Hallstedt, unpublished, 2008.
$
$ The system was investigated experimentally by A.A. Fabuyide et al. (J. Phase
$ Equilib. Diffus., 42, 42-62(2021)). They investigated as cast and 1273 K
$ annealed microstructures. Solidification sequences (but no temperatures)
$ allowed them to construct a liquidus surface and an isothermal section at
$ 1273 K. Phase compositions were analysed by EDX, i.e. C contents are
$ uncertain. In particular, the C content in the Ni-V phases seems far too
$ high. They also identified M6C (with the approximate composition Ni2V4C) at
$ 1273 K, but not at the liquidus surface.
$
$ This dataset is basically an extrapolation from the binaries with Ni4V2C
$ tentatively added.
$
$ 21Fab show Ni3V in equilibrium with graphite at 1273 K, whereas this dataset
$ shows fcc-Ni in equilibrium with VC (in accordance with previous data at
$ 1373 K).
$
 PAR  G(M6C_E93,NI:V:V:C),,             +2*GHSERNI+4*GHSERVV+GHSERCC
             -209000;,,                                               N 23Hal5 !
$
$ Metastable
$
 PAR  G(M23C6_D84,NI:V:C),,             +0.8695652*GNI23C6
             +0.1304348*GV23C6;,,                                     N Lin !
 PAR  G(M23C6_D84,V:NI:C),,             +0.8695652*GV23C6
             +0.1304348*GNI23C6;,,                                    N Lin !
