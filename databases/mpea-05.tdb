 PAR  L(M23C6_D84,FE:CR,FE:C;0),,       +991;,,                       N 14Khv !
 PAR  L(M23C6_D84,CR,FE:CR:C;1),,       -43600;,,                     N 14Khv !
 PAR  L(M23C6_D84,CR,FE:FE:C;1),,       -43600;,,                     N 14Khv !
