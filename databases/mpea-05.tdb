$
 PAR  L(FCC_A1,CR,MN:C;0),,             -19088+17.5423*T;,,           N 93Lee2 !
 PAR  L(A1_FCC,CR,MN:C;0),,             -19088+17.5423*T;,,           N 93Lee2 !
$
 PAR  L(HCP_A3,CR,MN:C;0),,             +60000;,,                     N 93Lee2 !
$
 PAR  L(CBCC_A12,CR,MN:C;0),,           -38349+22.6925*T;,,           N 93Lee2 !
