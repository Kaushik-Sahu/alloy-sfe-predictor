 FUNCTION U3ALFEMN  298.15  0.0;                                       6000 N !
 FUNCTION FALFEMN2  298.15  +UFALFE+2*UFALMN+2*UFFEMN+U1ALFEMN;        6000 N !
 FUNCTION FALFE2MN  298.15  +2*UFALFE+UFALMN+2*UFFEMN+U2ALFEMN;        6000 N !
 FUNCTION FAL2FEMN  298.15  +2*UFALFE+2*UFALMN+UFFEMN+U3ALFEMN;        6000 N !
$ ------------------------------------------------------------------------------
$ Al-Fe-Ni
$
$ L. Zhang, J. Wang, Y. Du, R. Hu, P. Nash, X.-G. Lu, C. Jiang,
$ Acta Mater., 57, 5324-41(2009).
$
$ Checked against paper.
$
$ Further modifications of the 09Zha dataset.
$
$ Al-Fe changed from 93Sei to 09Sun.
$ Al-Fe further changed to 17Zhe.
$ Fe-Ni changed from 03Dup to 10Cac.
$
$ Fcc changed from 2SL to 4SL.
$
$ Most ternary interactions are removed and replaced a few small interactions.
$ There are some differences compared to 09Zha. The most important are:
$ There is a wide bcc+B2 two-phase region in the Fe-rich part, which is stable
$ to high temperature, possibly too high. The shape of the L1_2 region has
$ changed, but can be relatively easily adjusted. There is a B2 single phase
$ region at x(Al)=0.6, wich might be questionable. The Al13Fe4 liquidus is a
$ bit too high. This can be fixed by slightly reducing the stability of
$ Al13Fe4, but this requires adjustment of the ternary phases tau-1 and tau-3
$ (at least).
$
$ The change of Fe-Ni results in rather small changes. Ni3Al extends a bit
$ further into the system so that the ternary interaction added previously
$ could be removed again. The Ni3Al phase boundary in the x(Ni)=0.75 section
$ shifts to higher Al at low temperature. The bcc+B2 two-phase region is
$ smaller, but still larger than in the original 09Zha dataset. B2 is even
$ more stable towards high Al content. The B2 liquidus/solidus are too high
$ at x(Al)=0.5. This can be fixed by removing the bcc interaction, but this
$ substantially shifts the fcc+bcc equilibria in the Fe corner. This will need
$ more work. Fe-Ni from 19Ohn could be helpful here.
$
 PAR  L(LIQUID,AL,FE,NI;0),,            +ZERO;,,                      N 20Hal7 !
$
 PAR  L(FCC_A1,AL,FE,NI:VA;0),,         +ZERO;,,                      N 20Hal7 !
 PAR  L(A1_FCC,AL,FE,NI:VA;0),,         +ZERO;,,                      N 20Hal7 !
$
 PAR  G(FCC_4SL,AL:AL:FE:NI:VA),,       +FAL2FENI;,,                  N 20Hal7 !
 PAR  G(FCC_4SL,FE:FE:AL:NI:VA),,       +FALFE2NI;,,                  N 20Hal7 !
 PAR  G(FCC_4SL,NI:NI:AL:FE:VA),,       +FALFENI2;,,                  N 20Hal7 !
$PAR  L(FCC_4SL,AL,FE:NI:NI:NI:VA;0),,  -2000;,,                      N 20Hal7 !
$
 PAR  L(BCC_A2,AL,FE,NI:VA;0),,         -30000;,,                     N 20Hal7 !
 PAR  L(A2_BCC,AL,FE,NI:VA;0),,         -30000;,,                     N 20Hal7 !
$
 PAR  L(AL9CO2,AL:FE,NI;0),,            -7000;,,                      N 20Hal7 !
 PAR  L(AL5CO2_D811,AL:FE,NI;0),,       -20000;,,                     N 20Hal7 !
 PAR  L(AL5CO2_D811,AL:FE,NI;1),,       -60000;,,                     N 20Hal7 !
 PAR  L(AL5FE2,AL:FE,NI;0),,            -239686.86;,,                 N 09Zha2 !
 PAR  G(AL71FE5NI24,AL:FE:NI),,         +0.71*GHSERAL+0.05*GHSERFE
             +0.24*GHSERNI-41075.33+3.0113*T;,,                       N 09Zha2 !
$
 PAR  G(AL3NI2_D513,AL:FE:NI),,         +3*GHSERAL+2*GHSERFE
             +GHSERNI;,,                                              N 09Zha2 !
 PAR  L(AL3NI2_D513,AL:FE,NI:NI;0),,    +888.5628-55*T;,,             N 09Zha2 !
 PAR  L(AL3NI2_D513,AL:FE,NI:VA;0),,    +888.5628-55*T;,,             N 09Zha2 !
$
$ Metastable
$
 PAR  G(GAMMA_D810,AL:FE:NI),,          +12*GHSERAL+5*GHSERFE
             +9*GHSERNI;,,                                            N Lin !
 PAR  G(GAMMA_D810,AL:NI:FE),,          +12*GHSERAL+5*GHSERNI
             +9*GHSERFE;,,                                            N Lin !
$
 PAR  G(SIGMA_D8B,AL:NI:FE),,           +10*GHSERAL+4*GBCCNI
             +16*GHSERFE;,,                                           N Lin !
 PAR  G(SIGMA_D8B,FE:NI:AL),,           +10*GFCCFE+4*GBCCNI
             +16*GBCCAL;,,                                            N Lin !
$
 FUNCTION U1ALFENI  298.15  +ZERO;                                     6000 N !
 FUNCTION U2ALFENI  298.15  +ZERO;                                     6000 N !
 FUNCTION U3ALFENI  298.15  -2000;                                     6000 N !
 FUNCTION FAL2FENI  298.15  +2*UFALFE+2*UFALNI+UFFENI+U1ALFENI;        6000 N !
 FUNCTION FALFE2NI  298.15  +2*UFALFE+UFALNI+2*UFFENI+U2ALFENI;        6000 N !
 FUNCTION FALFENI2  298.15  +UFALFE+2*UFALNI+2*UFFENI+U3ALFENI;        6000 N !
$ ------------------------------------------------------------------------------
$ Al-Fe-V
$
$ Not yet modelled.
$
$ According to Berche et al. (ab initio) there is a very stable Heusler
$ phase at AlFe2V, pushing B2 and bcc to the edges/corners (at 500 °C).
$
 PAR  G(SIGMA_D8B,AL:V:FE),,            +10*GHSERAL+4*GHSERVV
             +16*GHSERFE;,,                                           N Lin !
 PAR  G(SIGMA_D8B,FE:V:AL),,            +10*GFCCFE+4*GHSERVV
             +16*GBCCAL;,,                                            N Lin !
$ ------------------------------------------------------------------------------
$ Al-Mn-C
$
$ F. Tang, D. Bogdanovski, I. Bajenova, A.V. Khvan, R. Dronskowski,
$ B. Hallstedt, Calphad, 60, 231-39(2018).
$
$ Checked against paper.
$
 PAR  L(LIQUID,AL,C,MN;0),,             -70000;,,                     N 18Tan1 !
$
 PAR  L(FCC_A1,AL,MN:C;0),,             -5000;,,                      N 18Tan1 !
 PAR  L(FCC_A1,AL,MN:C;1),,             -15000;,,                     N 18Tan1 !
 PAR  L(FCC_A1,AL,MN:C,VA;0),,          -55000;,,                     N 18Tan1 !
 PAR  L(FCC_A1,AL,MN:C,VA;1),,          +50000;,,                     N 18Tan1 !
 PAR  L(FCC_A1,AL,MN:C,VA;2),,          -20000;,,                     N 18Tan1 !
$
 PAR  L(A1_FCC,AL,MN:C;0),,             -5000;,,                      N 18Tan1 !
 PAR  L(A1_FCC,AL,MN:C;1),,             -15000;,,                     N 18Tan1 !
 PAR  L(A1_FCC,AL,MN:C,VA;0),,          -55000;,,                     N 18Tan1 !
 PAR  L(A1_FCC,AL,MN:C,VA;1),,          +50000;,,                     N 18Tan1 !
 PAR  L(A1_FCC,AL,MN:C,VA;2),,          -20000;,,                     N 18Tan1 !
$
 PAR  L(HCP_A3,Al,MN:C;0),,             -5000;,,                      N 18Tan1 !
 PAR  L(HCP_A3,Al,MN:C;1),,             -29000+30*T;,,                N 18Tan1 !
 PAR  L(HCP_A3,AL,MN:C,VA;0),,          -174000+90*T;,,               N 18Tan1 !
 PAR  L(HCP_A3,AL,MN:C,VA;1),,          -3000;,,                      N 18Tan1 !
 PAR  L(HCP_A3,AL,MN:C,VA;2),,          -12000;,,                     N 18Tan1 !
$
 PAR  G(KAPPA_E21,AL:MN:C),,            +GHSERAL+3*GHSERMN+GHSERCC
             -121000+20*T;,,                                          N 18Tan1 !
 PAR  G(KAPPA_E21,MN:AL:C),,            +GHSERMN+3*GHSERAL+GHSERCC
             +136000-20*T;,,                                          N 18Tan1 !
 PAR  L(KAPPA_E21,AL,MN:MN:C;0),,       -7000;,,                      N 18Tan1 !
 PAR  L(KAPPA_E21,AL,MN:MN:C;1),,       -10000;,,                     N 18Tan1 !
 PAR  L(KAPPA_E21,AL:AL,MN:C;0),,       +ZERO;,,                      N 18Tan1 !
 PAR  L(KAPPA_E21,AL:MN:C,VA;0),,       +6500;,,                      N 18Tan1 !
 PAR  L(KAPPA_E21,AL:MN:C,VA;1),,       -5000;,,                      N 18Tan1 !
 PAR  L(KAPPA_E21,AL,MN:MN:C,VA;0),,    -4000;,,                      N 18Tan1 !
$
 PAR  L(M5C2,MN:AL,C;0),,               -55000-30*T;,,                N 18Tan1 !
 PAR  L(M5C2,MN:AL,C;1),,               +4000+10*T;,,                 N 18Tan1 !
$ ------------------------------------------------------------------------------
$ Al-Mn-Ni
$
$ A. Walnsch, M.J. Kriegel, M. Rudolph, M. Motylenko, O. Fabrichnaya,
$ A. Leineweber, Calphad, 64, 78-89(2019).
$
$ Checked against paper and author's tdb.
$
$ Al-Mn changed from 07Du (with B2 from 12Dju) to 18Zhe (i.e. 07Du with minor
$ changes and B2 and FCC-4SL from 12Dju).
$
$ This system is essentially completely remodelled from 19Wal in a rather
$ approximate fasion in order to remove the very large interactions and
$ temperature dependencies used by 19Wal. 19Wal is a blatant example of
$ overfitting. The present fit is rather approximate, so the system should be
$ reoptimized.
$
$ There are rather large differences compared to 19Wal.
$
 PAR  L(LIQUID,AL,MN,NI;0),,            +ZERO;,,                      N 20Hal8 !
$
 PAR  L(FCC_A1,AL,MN,NI:VA;0),,         +ZERO;,,                      N 20Hal8 !
 PAR  L(FCC_A1,AL,MN,NI:VA;1),,         +ZERO;,,                      N 20Hal8 !
 PAR  L(FCC_A1,AL,MN,NI:VA;2),,         -10000;,,                     N 20Hal8 !
$
 PAR  L(A1_FCC,AL,MN,NI:VA;0),,         +ZERO;,,                      N 20Hal8 !
 PAR  L(A1_FCC,AL,MN,NI:VA;1),,         +ZERO;,,                      N 20Hal8 !
 PAR  L(A1_FCC,AL,MN,NI:VA;2),,         -10000;,,                     N 20Hal8 !
$
 PAR  G(FCC_4SL,AL:AL:MN:NI:VA),,       +FAL2MNNI;,,                  N Lin !
 PAR  G(FCC_4SL,MN:MN:AL:NI:VA),,       +FALMN2NI;,,                  N Lin !
 PAR  G(FCC_4SL,NI:NI:AL:MN:VA),,       +FALMNNI2;,,                  N Lin !
$
 PAR  L(BCC_A2,AL,MN,NI:VA;0),,         +50000;,,                     N 20Hal8 !
 PAR  L(BCC_A2,AL,MN,NI:VA;1),,         -50000;,,                     N 20Hal8 !
 PAR  L(BCC_A2,AL,MN,NI:VA;2),,         +ZERO;,,                      N 20Hal8 !
$
 PAR  L(A2_BCC,AL,MN,NI:VA;0),,         +50000;,,                     N 20Hal8 !
 PAR  L(A2_BCC,AL,MN,NI:VA;1),,         -50000;,,                     N 20Hal8 !
 PAR  L(A2_BCC,AL,MN,NI:VA;2),,         +ZERO;,,                      N 20Hal8 !
$
 PAR  L(B2_BCC,AL,MN:NI:VA;0),,         +5000;,,                      N 20Hal8 !
 PAR  L(B2_BCC,NI:AL,MN:VA;0),,         +5000;,,                      N 20Hal8 !
 PAR  L(B2_BCC,AL,NI:MN:VA;0),,         -5000;,,                      N 20Hal8 !
 PAR  L(B2_BCC,MN:AL,NI:VA;0),,         -5000;,,                      N 20Hal8 !
$
 PAR  L(HCP_A3,AL,MN,NI:VA;0),,         -30000;,,                     N 20Hal8 !
 PAR  L(CUB_A13,AL,MN,NI:VA;0),,        +20000;,,                     N 20Hal8 !
$
 PAR  L(AL5CO2_D811,AL:MN,NI;0),,       -30000;,,                     N 20Hal8 !
$
 PAR  L(AL4M_MU,AL:MN,NI;0),,           -20000;,,                     N 20Hal8 !
 PAR  L(AL11MN4_HT,AL:MN,NI;0),,        -450000;,,                    N 20Hal8 !
$
 PAR  L(AL3NI_D011,AL:MN,NI;0),,        -16000;,,                     N 20Hal8 !
$
 PAR  G(AL3NI2_D513,AL:MN:NI),,         +3*GHSERAL+2*GHSERMN
             +GHSERNI;,,                                              N Lin !
$
 PAR  L(ALFEMN_ZETA,AL:MN,NI;0),,       -30000;,,                     N 20Hal8 !
 PAR  G(AL78MN13NI9,AL:MN:NI),,         +0.78*GHSERAL+0.13*GHSERMN
             +0.09*GHSERNI-31750+9*T;,,                               N 20Hal8 !
$
 PAR  G(GAMMA_D810,AL:MN:NI),,          +12*GHSERAL+5*GHSERMN
             +9*GHSERNI-1200000+103*T;,,                              N 20Hal8 !
 PAR  G(GAMMA_D810,AL:NI:MN),,          +12*GHSERAL+5*GHSERNI
             +9*GHSERMN-758800+186*T;,,                               N 20Hal8 !
 PAR  L(GAMMA_D810,AL:MN:AL,NI;0),,     -300000;,,                    N 20Hal8 !
$
 PAR  L(GAMMA_D82,AL:MN,NI;0),,         -215000;,,                    N 20Hal8 !
$
$ Metastable
$
 PAR  G(SIGMA_D8B,AL:NI:MN),,           +10*GHSERAL+4*GBCCNI
             +16*GBCCMN;,,                                            N Lin !
 PAR  G(SIGMA_D8B,MN:NI:AL),,           +10*GFCCMN+4*GBCCNI
             +16*GBCCAL;,,                                            N Lin !
$
 FUNCTION FAL2MNNI  298.15  +2*UFALMN+2*UFALNI+UFMNNI;                 6000 N !
 FUNCTION FALMN2NI  298.15  +2*UFALMN+UFALNI+2*UFMNNI;                 6000 N !
 FUNCTION FALMNNI2  298.15  +UFALMN+2*UFALNI+2*UFMNNI;                 6000 N !
$ ------------------------------------------------------------------------------
$ Al-Mn-V
$
$ Not yet modelled.
$
$ Exp. data are rather old, incomplete and imprecise. The calculation is
$ roughly in agreement. Sigma and hcp should probably extend further into
$ the ternary.
$
 PAR  G(SIGMA_D8B,AL:V:MN),,            +10*GHSERAL+4*GHSERVV
             +16*GBCCMN;,,                                            N Lin !
 PAR  G(SIGMA_D8B,MN:V:AL),,            +10*GFCCMN+4*GHSERVV
             +16*GBCCAL;,,                                            N Lin !
$ ------------------------------------------------------------------------------
$ Al-Ni-C
$
$ W. Zheng, Y. He, X. Liu, J. Iron Steel Res. Int., 27, 1190-99(2020).
$
$ Checked against paper.
$
$ The ternary bcc interaction was removed to decrease the C solubility in B2.
$ Liquid interaction from 14Wan used.
$
$ In the paper 20Zhe use an unpublished modified version of Al-Ni from 01Dup.
$ According to the paper the modfication concerns liquid and bcc. No parameters
$ are published. Here the 01Dup version is used (which also includes a few
$ modifications).
$
$ The C solubility in fcc and L1_2 is rather high, which seems reasonable.
$
 PAR  L(LIQUID,AL,C,NI;0),,             +100000;,,                    N 14Wan !
 PAR  L(LIQUID,AL,C,NI;1),,             +ZERO;,,                      N 14Wan !
 PAR  L(LIQUID,AL,C,NI;2),,             -50000;,,                     N 14Wan !
$
 PAR  L(FCC_A1,AL,NI:C,VA;0),,          -489000+202*T;,,              N 20Zhe !
 PAR  L(A1_FCC,AL,NI:C,VA;0),,          -489000+202*T;,,              N 20Zhe !
$
$PAR  L(BCC_A2,AL,NI:C,VA;0),,          -1186000+210*T;,,             N 20Zhe !
$PAR  L(A2_BCC,AL,NI:C,VA;0),,          -1186000+210*T;,,             N 20Zhe !
$
 PAR  G(KAPPA_E21,AL:NI:C),,            +GHSERAL+3*GHSERNI+GHSERCC
             -141000;,,                                               N 04Oht !
$ ------------------------------------------------------------------------------
$ Al-Ni-V
$
$ Not yet modelled. See H. Zapolsky, Calphad 2001.
$
$ This system is being modelled by Mehdi Noori.
$
$ B2 extends too far towards V. It should extend less and rather in the
$ direction of NiV (at least at lower T). L1_2 and fcc also extend too far
$ and in the wrong direction. Using the ternary ordering contributions results
$ in further extension of L1_2, but also a more reasonable shape. Several
$ other phases, sigma, Ni3V etc, that should extend into the ternary do not
$ do that.
$
 PAR  G(FCC_4SL,AL:AL:NI:V:VA),,        +FAL2NIV;,,                   N !
 PAR  G(FCC_4SL,NI:NI:AL:V:VA),,        +FALNI2V;,,                   N !
 PAR  G(FCC_4SL,V:V:AL:NI:VA),,         +FALNIV2;,,                   N !
$
 PAR  G(SIGMA_D8B,AL:NI:V),,            +10*GHSERAL+4*GBCCNI
             +16*GHSERVV;,,                                           N Lin !
 PAR  G(SIGMA_D8B,AL:V:NI),,            +10*GHSERAL+4*GHSERVV
             +16*GBCCNI;,,                                            N Lin !
 PAR  G(SIGMA_D8B,NI:V:AL),,            +10*GHSERNI+4*GHSERVV
             +16*GBCCAL;,,                                            N Lin !
 PAR  G(SIGMA_D8B,V:NI:AL),,            +10*GFCCVV+4*GBCCNI
             +16*GBCCAL;,,                                            N Lin !
$
 FUNCTION U1ALNIV   298.15  0;                                         6000 N !
 FUNCTION U2ALNIV   298.15  0;                                         6000 N !
 FUNCTION U3ALNIV   298.15  0;                                         6000 N !
 FUNCTION FAL2NIV   298.15  +2*UFALNI+2*UFALV+UFNIV+U1ALNIV;           6000 N !
 FUNCTION FALNI2V   298.15  +2*UFALNI+UFALV+2*UFNIV+U2ALNIV;           6000 N !
 FUNCTION FALNIV2   298.15  +UFALNI+2*UFALV+2*UFNIV+U3ALNIV;           6000 N !
$ ------------------------------------------------------------------------------
$ Al-V-C
$
$ B. Hallstedt, Calphad, 41, 156-59(2013).
$
$ Checked against paper.
$
$ Al-V changed from 98Sau to 15Lin.
$ V-C changed from 91Hua to 20Hua (minor modification of 91Hua).
$ Al added on the first sub-lattice of V2ALC (consistency with Al-Cr-C).
$
$ At 1273 K there is an equilibrium between Al3V and Al4C3 instead of
$ Al(Liq.) and V2AlC. This is in conflict with the experimental work of
$ Schuster et al. and indicates that V2AlC could be somewhat more stable.
$ The bcc composition in the equilibrium V2AlC + V2C + bcc is now closer
$ to the experimental value. At 1773 K the changes correspond to those in
$ in the Al-V system. The MAX-phases are not stable at 2773 K any more.
$ The results at 2573 K are similar to the previous results at 2773 K.
$ In particular the melting temperature of V2AlC hase decreased by more than
$ 200 K.
$
 PAR  G(MAX_PHASE,V:AL:C),,             +2*GHSERVV+GHSERAL+GHSERCC
             -198000;,,                                               N 13Hal !
$
 PAR  G(V4ALC3,V:AL:C:C),,              +4*GHSERVV+GHSERAL+3*GHSERCC
             -378000;,,                                               N 13Hal !
 PAR  G(V4ALC3,V:AL:C:VA),,             +4*GHSERVV+GHSERAL+2*GHSERCC
             -300000;,,                                               N 13Hal !
 PAR  L(V4ALC3,V:AL:C:C,VA;0),,         -50000;,,                     N 13Hal !
$
$ metastable
$
 PAR  G(V3ALC2,V:AL:C),,                +3*GHSERVV+GHSERAL+2*GHSERCC
             -285000;,,                                               N 13Hal !
$ ------------------------------------------------------------------------------
$ Co-Cr-C
$
$ B. Kaplan, A. Markstrom, A. Blomqvist, S. Norgren, M. Selleby,
$ Calphad, 46, 226-36(2014).
$
$ Checked against paper, author's tdb and CoCrC-14Kap.tdb.
$
$ Cr-C is changed from 92Lee1 to 12Khv1. This only concerns the liquid.
$ The G(FCC_A1,CR:C) parameter is taken from 92Lee1 instead of 04Bra.
$ This makes the fcc and liquid slightly less stable.
$
$ Cementite is given a positive interaction to avoid stable cementite. The
$ size of the interaction is similar to that of M7C3 and M23C6, but
$ without a subregular term.
$
 PAR  L(LIQUID,C,CO,CR;0),,             -258600;,,                    N 14Kap !
 PAR  L(LIQUID,C,CO,CR;1),,             +8060;,,                      N 14Kap !
 PAR  L(LIQUID,C,CO,CR;2),,             +33500;,,                     N 14Kap !
$
 PAR  L(BCC_A2,CO,CR:C;0),,             +17208-13.519*T;,,            N 97Kus !
 PAR  L(BCC_A2,CO,CR:C;1),,             -5470;,,                      N 97Kus !
$
 PAR  L(A2_BCC,CO,CR:C;0),,             +17208-13.519*T;,,            N 97Kus !
 PAR  L(A2_BCC,CO,CR:C;1),,             -5470;,,                      N 97Kus !
$
 PAR  L(FCC_A1,CO,CR:C;0),,             +ZERO;,,                      N 14Kap !
 PAR  L(A1_FCC,CO,CR:C;0),,             +ZERO;,,                      N 14Kap !
 PAR  L(HCP_A3,CO,CR:C;0),,             -6436;,,                      N 97Kus !
$
 PAR  G(M23C6_D84,CO:CR:C),,            +0.869565*GCO23C6
             +0.130435*GCR23C6+0.113422*L0COCR23
             +0.083833*L1COCR23;,,                                    N 14Kap !
 PAR  G(M23C6_D84,CR:CO:C),,            +0.869565*GCR23C6
             +0.130435*GCO23C6+0.113422*L0COCR23
             -0.083833*L1COCR23;,,                                    N 14Kap !
 PAR  L(M23C6_D84,CO,CR:CO:C;0),,       +0.756144*L0COCR23
             +0.295881*L1COCR23;,,                                    N 14Kap !
 PAR  L(M23C6_D84,CO,CR:CR:C;0),,       +0.756144*L0COCR23
             -0.295881*L1COCR23;,,                                    N 14Kap !
 PAR  L(M23C6_D84,CO:CO,CR:C;0),,       +0.017013*L0COCR23
             +0.044382*L1COCR23;,,                                    N 14Kap !
 PAR  L(M23C6_D84,CR:CO,CR:C;0),,       +0.017013*L0COCR23
             -0.044382*L1COCR23;,,                                    N 14Kap !
 PAR  L(M23C6_D84,CO,CR:CO:C;1),,       +0.657516*L1COCR23;,,         N 14Kap !
 PAR  L(M23C6_D84,CO,CR:CR:C;1),,       +0.657516*L1COCR23;,,         N 14Kap !
 PAR  L(M23C6_D84,CO:CO,CR:C;1),,       +0.002219*L1COCR23;,,         N 14Kap !
 PAR  L(M23C6_D84,CR:CO,CR:C;1),,       +0.002219*L1COCR23;,,         N 14Kap !
$
 PAR  L(M7C3_D101,CO,CR:C;0),,          +339880-192*T;,,              N 14Kap !
 PAR  L(M7C3_D101,CO,CR:C;1),,          +230500-117*T;,,              N 14Kap !
$
 PAR  G(CR3C2_D510,CO,CR:C),,           -4.3*T;,,                     N 14Kap !
$
$ metastable
$
 PAR  L(CEMENTITE_D011,CO,CR:C;0),,     +160000-80*T;,,               N 17Hal3 !
$
 FUNCTION L0COCR23  298.15  +1822000-1282*T;                           6000 N !
 FUNCTION L1COCR23  298.15  +391000;                                   6000 N !
$ ------------------------------------------------------------------------------
$ Co-Cr-Fe
$
$ W.-M. Choi, Y.H. Jo, D.G. Kim, S.S. Sohn, S. Lee, B.-J. Lee,
$ Calphad, 66, 101624(2019).
$
$ Checked against paper and author's tdb.
$
$ In the paper the 8:4:18 model for sigma is used.
$
$ The sigma phase model is changed from 8:4:18 to 10:4:16.
$ Co-Fe from AFG 1987 is replaced by Ohnuma 2002.
$
$ There are some smaller shifts, mostly because of the narrower sigma field
$ in Co-Cr.
$
 PAR  L(LIQUID,CO,CR,FE;0),,            +ZERO;,,                      N 19Cho !
$
 PAR  L(FCC_A1,CO,CR,FE:VA;0),,         +3000;,,                      N 19Cho !
 PAR  L(A1_FCC,CO,CR,FE:VA;0),,         +3000;,,                      N 19Cho !
$
 PAR  G(FCC_4SL,CO:CO:CR:FE:VA),,       +FCO2CRFE;,,                  N Lin !
 PAR  G(FCC_4SL,CR:CR:CO:FE:VA),,       +FCOCR2FE;,,                  N Lin !
 PAR  G(FCC_4SL,FE:FE:CO:CR:VA),,       +FCOCRFE2;,,                  N Lin !
$
 PAR  L(BCC_A2,CO,CR,FE:VA;0),,         -1000;,,                      N 19Cho !
 PAR  L(A2_BCC,CO,CR,FE:VA;0),,         -1000;,,                      N 19Cho !
$
 PAR  G(SIGMA_D8B,CO:CR:FE),,           +0.3846*GSCOCRCO
             +0.6154*GSFECRFE;,,                                      N 20Hal1 !
 PAR  G(SIGMA_D8B,FE:CR:CO),,           +0.3846*GSFECRFE
             +0.6154*GSCOCRCO;,,                                      N 20Hal1 !
 PAR  L(SIGMA_D8B,CO,FE:CR:CO;0),,      -65000;,,                     N 20Hal1 !
 PAR  L(SIGMA_D8B,CO,FE:CR:CR;0),,      -65000;,,                     N 20Hal1 !
 PAR  L(SIGMA_D8B,CO,FE:CR:FE;0),,      -65000;,,                     N 20Hal1 !
$
 FUNCTION U1COCRFE  298.15  0.0;                                       6000 N !
 FUNCTION U2COCRFE  298.15  0.0;                                       6000 N !
 FUNCTION U3COCRFE  298.15  0.0;                                       6000 N !
 FUNCTION FCOCRFE2  298.15  +UFCOCR+2*UFCOFE+2*UFCRFE+U1COCRFE;        6000 N !
 FUNCTION FCOCR2FE  298.15  +2*UFCOCR+UFCOFE+2*UFCRFE+U2COCRFE;        6000 N !
 FUNCTION FCO2CRFE  298.15  +2*UFCOCR+2*UFCOFE+UFCRFE+U3COCRFE;        6000 N !
$ ------------------------------------------------------------------------------
$ Co-Cr-Mn
$
$ H.-S. Do, W.-M. Choi, B.-J. Lee, J. Mater. Sci, 57, 1373-89(2022).
$
$ Checked against paper.
$
$ The 8:4:18 sigma model is used by 22Do.
$
$ The SIGMA_D8B parameters were modified to get a similar width of the sigma
$ phase field as with SIGMA_OLD. SIGMA_D8B also extends considerably further
$ towards the Cr-Mn side at high T, which is important when high-sigma is
$ removed. SIGMA_OLD by itself (without OLD_HIGH) does not quite match
$ experimental data.
$
 PAR  L(LIQUID,CO,CR,MN;0),,            -16000;,,                     N 22Do !
$
 PAR  L(FCC_A1,CO,CR,MN:VA;0),,         -16000;,,                     N 22Do !
 PAR  L(A1_FCC,CO,CR,MN:VA;0),,         -16000;,,                     N 22Do !
$
 PAR  G(FCC_4SL,CO:CO:CR:MN:VA),,       +FCO2CRMN;,,                  N Lin !
 PAR  G(FCC_4SL,CR:CR:CO:MN:VA),,       +FCOCR2MN;,,                  N Lin !
 PAR  G(FCC_4SL,MN:MN:CO:CR:VA),,       +FCOCRMN2;,,                  N Lin !
$
 PAR  L(BCC_A2,CO,CR,MN:VA;0),,         -10000;,,                     N 22Do !
 PAR  L(A2_BCC,CO,CR,MN:VA;0),,         -10000;,,                     N 22Do !
$
 PAR  L(HCP_A3,CO,CR,MN:VA;0),,         -22000;,,                     N 22Do !
 PAR  L(CUB_A13,CO,CR,MN:VA;0),,        -60000;,,                     N 22Do !
$
 PAR  G(SIGMA_D8B,CO:CR:MN),,           +0.3846*GSCOCRCO
             +0.6154*GSMNCRMN-290000;,,                               N 23Hal1 !
 PAR  G(SIGMA_D8B,MN:CR:CO),,           +0.3846*GSMNCRMN
             +0.6154*GSCOCRCO;,,                                      N 22Do !
 PAR  L(SIGMA_D8B,CO:CR:CO,MN;0),,      -200000;,,                    N 22Do !
 PAR  L(SIGMA_D8B,MN:CR:CO,MN;0),,      -200000;,,                    N 22Do !
 PAR  L(SIGMA_D8B,CO:CR:CR,MN;0),,      -85000;,,                     N 22Do !
 PAR  L(SIGMA_D8B,CO,MN:CR:*;0),,       -100000;,,                    N 23Hal1 !
$
 FUNCTION U1COCRMN  298.15  0.0;                                       6000 N !
 FUNCTION U2COCRMN  298.15  0.0;                                       6000 N !
 FUNCTION U3COCRMN  298.15  0.0;                                       6000 N !
 FUNCTION FCOCRMN2  298.15  +UFCOCR+2*UFCOMN+2*UFCRMN+U1COCRMN;        6000 N !
 FUNCTION FCOCR2MN  298.15  +2*UFCOCR+UFCOMN+2*UFCRMN+U2COCRMN;        6000 N !
 FUNCTION FCO2CRMN  298.15  +2*UFCOCR+2*UFCOMN+UFCRMN+U3COCRMN;        6000 N !
$ ------------------------------------------------------------------------------
$ Co-Cr-Ni
$
$ X.L. Liu, G. Lindwall, T. Gheno, Z.-K. Liu, Calphad, 52, 125-142(2016).
$
$ Checked against paper.
$
$ This dataset contains Cr-Ni from 16Tan instead of 92Lee. It also contains
$ a 10:4:16 model for sigma instead of 8:4:18.
$
$ Sigma and hcp interactions have been added to approximately reproduce the
$ isothermal section at 1073 K shown in S. Yang et al. 2012.
$
 PAR  L(LIQUID,CO,CR,NI;0),,            -16000;,,                     N 16Liu !
$
 PAR  L(FCC_A1,CO,CR,NI:VA;0),,         -40710+13.533*T;,,            N 16Liu !
 PAR  L(A1_FCC,CO,CR,NI:VA;0),,         -40710+13.533*T;,,            N 16Liu !
$
 PAR  G(FCC_4SL,CO:CO:CR:NI:VA),,       +FCO2CRNI;,,                  N Lin !
 PAR  G(FCC_4SL,CR:CR:CO:NI:VA),,       +FCOCR2NI;,,                  N Lin !
 PAR  G(FCC_4SL,NI:NI:CO:CR:VA),,       +FCOCRNI2;,,                  N Lin !
$
 PAR  L(BCC_A2,CO,CR,NI:VA;0),,         -60134+17.7*T;,,              N 16Liu !
 PAR  L(A2_BCC,CO,CR,NI:VA;0),,         -60134+17.7*T;,,              N 16Liu !
$
 PAR  L(HCP_A3,CO,CR,NI:VA;0),,         -10000;,,                     N 16Hal8 !
$
 PAR  G(SIGMA_D8B,CO:CR:NI),,           +10*GHSERCO+4*GHSERCR
             +16*GBCCNI;,,                                            N 16Liu !
 PAR  G(SIGMA_D8B,CO:NI:CR),,           +10*GHSERCO+4*GBCCNI
             +16*GHSERCR;,,                                           N Lin !
 PAR  G(SIGMA_D8B,NI:CR:CO),,           +10*GHSERNI+4*GHSERCR
             +16*GBCCCO;,,                                            N 16Liu !
 PAR  L(SIGMA_D8B,CO,NI:CR:CR;0),,      -140000+100*T;,,              N 16Hal8 !
$
 FUNCTION U1COCRNI  298.15  0.0;                                       6000 N !
 FUNCTION U2COCRNI  298.15  0.0;                                       6000 N !
 FUNCTION U3COCRNI  298.15  0.0;                                       6000 N !
 FUNCTION FCOCRNI2  298.15  +UFCOCR+2*UFCONI+2*UFCRNI+U1COCRNI;        6000 N !
 FUNCTION FCOCR2NI  298.15  +2*UFCOCR+UFCONI+2*UFCRNI+U2COCRNI;        6000 N !
 FUNCTION FCO2CRNI  298.15  +2*UFCOCR+2*UFCONI+UFCRNI+U3COCRNI;        6000 N !
$ ------------------------------------------------------------------------------
$ Co-Cr-V
$
$ W.-M. Choi, Y.H. Jo, D.G. Kim, S.S. Sohn, S. Lee, B.-J. Lee,
$ Calphad, 66, 101624(2019).
$
$ Checked against paper and author's tdb.
$
$ 2023.08.22: G(MV3_A15,CO:CR) removed because MV3_A15 becomes stable in Co-Cr
$             below 673 K.
$
$ Sigma chenged from 8:4:18 to 10:4:16.
$ Added fcc and bcc ordering.
$ Cr solubility added in CoV3 (exp. data from C.C. Zhao 2012).
$ Co-V changed from 04 Hua to 20Wan-mod.
$
$ There are rather large differences between the original and the present
$ dataset. The original dataset generally matches experimental data better,
$ but the direction of the tielines between sigma and bcc are better with the
$ present dataset. The sigma phase field is narrower and the Co solubility is
$ considerably less, particularly at low temperature. This is at least
$ partially a consequence of changes in the Co-V binary phase diagram.
$
 PAR  G(FCC_4SL,CO:CO:CR:V:VA),,        +FCO2CRV;,,                   N Lin !
 PAR  G(FCC_4SL,CR:CR:CO:V:VA),,        +FCOCR2V;,,                   N Lin !
 PAR  G(FCC_4SL,V:V:CO:CR:VA),,         +FCOCRV2;,,                   N Lin !
$
 PAR  L(M3V,CO:CR,V;0),,                -20000;,,                     N 19Cho !
$
 PAR  G(SIGMA_D8B,CO:CR:V),,            +0.2*GSCOCRCR+0.8*GSCOVV;,,   N 19Cho !
 PAR  G(SIGMA_D8B,CO:V:CR),,            +0.2*GSCOVV+0.8*GSCOCRCR;,,   N 19Cho !
 PAR  G(SIGMA_D8B,V:CR:CO),,            +16*GHSERCO+10*GHSERVV
             +4*GHSERCR;,,                                            N Lin !
 PAR  L(SIGMA_D8B,CO:CR:CR,V;0),,       -200000;,,                    N 19Cho !
 PAR  L(SIGMA_D8B,CO:V:CR,V;0),,        -200000;,,                    N 19Cho !
 PAR  L(SIGMA_D8B,CO:CR,V:CO;0),,       -60000;,,                     N 19Cho !
 PAR  L(SIGMA_D8B,CO:CR,V:CR;0),,       -60000;,,                     N 19Cho !
 PAR  L(SIGMA_D8B,CO:CR,V:V;0),,        -60000;,,                     N 19Cho !
$
 PAR  L(MV3_A15,CO:CR,V;0),,            -20000;,,                     N 21Hal3 !
$
 FUNCTION U1COCRV   298.15  0.0;                                       6000 N !
 FUNCTION U2COCRV   298.15  0.0;                                       6000 N !
 FUNCTION U3COCRV   298.15  0.0;                                       6000 N !
 FUNCTION FCOCRV2   298.15  +UFCOCR+2*UFCOV+2*UFCRV+U1COCRV;           6000 N !
 FUNCTION FCOCR2V   298.15  +2*UFCOCR+UFCOV+2*UFCRV+U2COCRV;           6000 N !
 FUNCTION FCO2CRV   298.15  +2*UFCOCR+2*UFCOV+UFCRV+U3COCRV;           6000 N !
$ ------------------------------------------------------------------------------
$ Co-Fe-C
$
$ A. Fernandez Guillermet, Z. Metallkd., 79, 317-29(1988).
$
$ Checked against paper.
$
$ Changed Co-Fe from 87Fer to 02Ohn.
$
 PAR  L(LIQUID,C,CO,FE;0),,             +11646-5.657*T;,,             N 88Fer1 !
$
 PAR  L(FCC_A1,CO,FE:C;0),,             +313;,,                       N 88Fer1 !
 PAR  L(FCC_A1,CO,FE:C;1),,             -1063;,,                      N 88Fer1 !
$
 PAR  L(A1_FCC,CO,FE:C;0),,             +313;,,                       N 88Fer1 !
 PAR  L(A1_FCC,CO,FE:C;1),,             -1063;,,                      N 88Fer1 !
$
$ Metastable
$
 PAR  G(KAPPA_E21,FE:CO:C),,            +3*GFCCFE+GFCCCO+GHSERCC;,,   N Lin !
 PAR  G(KAPPA_E21,CO:FE:C),,            +3*GFCCCO+GFCCFE+GHSERCC;,,   N Lin !
$
 PAR  G(M23C6_D84,CO:FE:C),,            +0.8695652*GCO23C6
             +0.1304348*GFE23C6;,,                                    N Lin !
 PAR  G(M23C6_D84,FE:CO:C),,            +0.8695652*GFE23C6
             +0.1304348*GCO23C6;,,                                    N Lin !
$ ------------------------------------------------------------------------------
$ Co-Fe-Mn
$
$ W. Huang, Calphad, 14, 11-22(1990).
$
$ No ternary parameters.
$
$ The Co-Fe dataset from 87Fer2 is replaced with the dataset from 02Ohn.
$
$ Checked against paper and CoFeMn-90Hua.tdb.
$
$ At high temperature the differences are small between this version and the
$ original version. At low temperature (673 K and lower) the appearance
$ of the B2 phase causes some differences. Even at 873 K where the B2
$ is present (in this dataset) differences are very small.
$
 PAR  G(FCC_4SL,CO:CO:FE:MN:VA),,       +FCO2FEMN;,,                  N Lin !
 PAR  G(FCC_4SL,FE:FE:CO:MN:VA),,       +FCOFE2MN;,,                  N Lin !
 PAR  G(FCC_4SL,MN:MN:CO:FE:VA),,       +FCOFEMN2;,,                  N Lin !
$
 FUNCTION U1COFEMN  298.15  0.0;                                       6000 N !
 FUNCTION U2COFEMN  298.15  0.0;                                       6000 N !
 FUNCTION U3COFEMN  298.15  0.0;                                       6000 N !
 FUNCTION FCOFEMN2  298.15  +UFCOFE+2*UFCOMN+2*UFFEMN+U1COFEMN;        6000 N !
 FUNCTION FCOFE2MN  298.15  +2*UFCOFE+UFCOMN+2*UFFEMN+U2COFEMN;        6000 N !
 FUNCTION FCO2FEMN  298.15  +2*UFCOFE+2*UFCOMN+UFFEMN+U3COFEMN;        6000 N !
$ ------------------------------------------------------------------------------
$ Co-Fe-Ni
$
$ A. Fernandez Guillermet, Calphad, 13, 1-22(1989).
$
$ Checked against paper.
$
$ No ternary parameters.
$
$ The Co-Fe dataset from 87Fer2 is replaced with the dataset from 02Ohn and
$ the Fe-Ni dataset from 85Xin is replaced with the dataset from 03Dup.
$ Fe-Ni is further changed from 03Dup to 10Cac.
$
$ The change of Fe-Ni to 10Cac causes only minor changes.
$
$ At high temperature the differences in fcc-bcc between the original and this
$ dataset are very small. The changes in the fcc liquidus surface are a bit
$ larger. No experimental ternary liquidus data are shown in 89Fer2.
$ At 873 K B2 ordering in the Co-Fe system has a small, but visible
$ influence on the phase diagram. At 773 K the influence is slightly larger,
$ but still close to the disordered state.
$
 PAR  G(FCC_4SL,CO:CO:FE:NI:VA),,       +FCO2FENI;,,                  N Lin !
 PAR  G(FCC_4SL,FE:FE:CO:NI:VA),,       +FCOFE2NI;,,                  N Lin !
 PAR  G(FCC_4SL,NI:NI:CO:FE:VA),,       +FCOFENI2;,,                  N Lin !
$
$ Metastable
$
 PAR  G(SIGMA_D8B,CO:NI:FE),,           +10*GHSERCO+4*GBCCNI
             +16*GHSERFE;,,                                           N Lin !
 PAR  G(SIGMA_D8B,FE:NI:CO),,           +10*GFCCFE+4*GBCCNI
             +16*GBCCCO;,,                                            N Lin !
$
 FUNCTION U1COFENI  298.15  0.0;                                       6000 N !
 FUNCTION U2COFENI  298.15  0.0;                                       6000 N !
 FUNCTION U3COFENI  298.15  0.0;                                       6000 N !
 FUNCTION FCOFENI2  298.15  +UFCOFE+2*UFCONI+2*UFFENI+U1COFENI;        6000 N !
 FUNCTION FCOFE2NI  298.15  +2*UFCOFE+UFCONI+2*UFFENI+U2COFENI;        6000 N !
 FUNCTION FCO2FENI  298.15  +2*UFCOFE+2*UFCONI+UFFENI+U3COFENI;        6000 N !
$ ------------------------------------------------------------------------------
$ Co-Fe-V
$
$ W.-M. Choi, Y.H. Jo, D.G. Kim, S.S. Sohn, S. Lee, B.-J. Lee,
$ Calphad, 66, 101624(2019).
$
$ Checked against paper and author's tdb.
$
$ Sigma chenged from 8:4:18 to 10:4:16.
$ Added fcc and bcc ordering.
$ Co-Fe changed from 87Fer to 02Ohn.
$ Co-V changed from 04Hua to 20Wan-mod.
$
$ The results are rather different from 19Cho. The bcc is too stable towards
$ the Co-V binary around x(V)=0.4 at high temperature (1473 K). This is likely
$ a problem with the bcc phase being too stable in the Co-V binary. The
$ extension of Co3V is better than in 19Cho. Sigma is too stable at high
$ temperature between CoV2 and FeV. This system needs to be remodelled,
$ preferrably together with Co-V and, possibly, Fe-V.
$
 PAR  L(LIQUID,CO,FE,V;0),,             +30000;,,                     N 19Cho !
$
 PAR  L(FCC_A1,CO,FE,V:VA;0),,          +5000;,,                      N 19Cho !
 PAR  L(A1_FCC,CO,FE,V:VA;0),,          +5000;,,                      N 19Cho !
$
 PAR  G(FCC_4SL,CO:CO:FE:V:VA),,        +FCO2FEV;,,                   N Lin !
 PAR  G(FCC_4SL,FE:FE:CO:V:VA),,        +FCOFE2V;,,                   N Lin !
 PAR  G(FCC_4SL,V:V:CO:FE:VA),,         +FCOFEV2;,,                   N Lin !
$
$PAR  L(BCC_A2,CO,FE,V:VA;0),,          -17095+15*T;,,                N 19Cho !
 PAR  L(BCC_A2,CO,FE,V:VA;0),,          +15000;,,                     N 21Hal4 !
$PAR  L(A2_BCC,CO,FE,V:VA;0),,          -17095+15*T;,,                N 19Cho !
 PAR  L(A2_BCC,CO,FE,V:VA;0),,          +15000;,,                     N 21Hal4 !
$
 PAR  L(M3V,CO,FE:V;0),,                -20000;,,                     N 19Cho !
$
 PAR  G(SIGMA_D8B,CO:V:FE),,            +0.3846*GSCOVCO
             +0.6154*GSFEVFE;,,                                       N 19Cho !
 PAR  G(SIGMA_D8B,FE:V:CO),,            +0.3846*GSFEVFE
             +0.6154*GSCOVCO;,,                                       N 19Cho !
 PAR  L(SIGMA_D8B,CO,FE:V:CO;0),,       -60000;,,                     N 19Cho !
 PAR  L(SIGMA_D8B,CO,FE:V:FE;0),,       -60000;,,                     N 19Cho !
 PAR  L(SIGMA_D8B,CO,FE:V:V;0),,        -60000;,,                     N 19Cho !
 PAR  L(SIGMA_D8B,CO:V:CO,FE,V;0),,     -300000;,,                    N 19Cho !
 PAR  L(SIGMA_D8B,FE:V:CO,FE,V;0),,     -300000;,,                    N 19Cho !
$
 FUNCTION U1COFEV   298.15  0.0;                                       6000 N !
 FUNCTION U2COFEV   298.15  0.0;                                       6000 N !
 FUNCTION U3COFEV   298.15  0.0;                                       6000 N !
 FUNCTION FCOFEV2   298.15  +UFCOFE+2*UFCOV+2*UFFEV+U1COFEV;           6000 N !
 FUNCTION FCOFE2V   298.15  +2*UFCOFE+UFCOV+2*UFFEV+U2COFEV;           6000 N !
