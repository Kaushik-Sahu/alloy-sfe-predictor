             +5*GHSERNI-872968+80*T;,,                                N 18Wan !
 PAR  G(ALCONI_T1,AL:NI:CO),,           +14*GHSERAL+GHSERNI
             +5*GHSERCO-972000+185.75*T;,,                            N 20Hal4 !
 PAR  L(ALCONI_T1,AL:AL,CO:NI;0),,      -85000;,,                     N 18Wan !
 PAR  L(ALCONI_T1,AL:AL,NI:CO;0),,      -7000;,,                      N 18Wan !
 PAR  L(ALCONI_T1,AL:CO,NI:CO;0),,      -12500;,,                     N 18Wan !
 PAR  L(ALCONI_T1,AL:CO,NI:NI;0),,      -85500;,,                     N 18Wan !
 PAR  L(ALCONI_T1,AL:AL:CO,NI;0),,      -303293+112*T;,,              N 18Wan !
 PAR  L(ALCONI_T1,AL:CO:CO,NI;0),,      -55000;,,                     N 18Wan !
 PAR  L(ALCONI_T1,AL:NI:CO,NI;0),,      -88030+10*T;,,                N 18Wan !
 PAR  L(ALCONI_T1,AL:CO,NI:CO,NI;0),,   -90000;,,                     N 18Wan !
$
 PAR  L(ALCONI_T2,AL:CO,NI;0),,         -65600+14.5*T;,,              N 20Hal4 !
 PAR  L(ALCONI_T2,AL:CO,NI;1),,         -10700;,,                     N 18Wan !
$
 PAR  G(ALCONI_T3,AL:CO:NI),,           +9*GHSERAL+2*GHSERCO
             +2*GHSERNI-679003.5+122.65*T;,,                          N 18Wan !
 PAR  L(ALCONI_T3,AL:CO:CO,NI;0),,      -163374;,,                    N 18Wan !
 PAR  L(ALCONI_T3,AL:CO:CO,NI;1),,      -70000;,,                     N 18Wan !
$
$ Metastable
$
 PAR  G(GAMMA_D810,AL:CO:NI),,          +12*GHSERAL+5*GHSERCO
             +9*GHSERNI;,,                                            N Lin !
$
 PAR  G(SIGMA_D8B,AL:NI:CO),,           +10*GHSERAL+4*GBCCNI
             +16*GBCCCO;,,                                            N Lin !
 PAR  G(SIGMA_D8B,CO:NI:AL),,           +10*GFCCCO+4*GBCCNI
             +16*GBCCAL;,,                                            N Lin !
$
 FUNCTION U1ALCONI  298.15  0;                                         6000 N !
 FUNCTION U2ALCONI  298.15  0;                                         6000 N !
 FUNCTION U3ALCONI  298.15  +1000;                                     6000 N !
 FUNCTION FAL2CONI  298.15  +2*UFALCO+2*UFALNI+UFCONI+U1ALCONI;        6000 N !
