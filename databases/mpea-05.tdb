 PAR  L(A1_FCC,MN,NI:VA;1),,            +LDF1MNNI;,,                  N 10Liu !
 PAR  TC(A1_FCC,MN,NI:VA;0),,           -3171.20;,,                   N 05Guo !
 PAR  TC(A1_FCC,MN,NI:VA;1),,           -4317.73;,,                   N 05Guo !
 PAR  BM(A1_FCC,MN,NI:VA;0),,              -1.3947;,,                 N 05Guo !
 PAR  BM(A1_FCC,MN,NI:VA;1),,              +3.9050;,,                 N 05Guo !
$
 PAR  G(FCC_4SL,MN:MN:MN:NI:VA),,       +GFMN3NI;,,                   N 10Liu !
 PAR  G(FCC_4SL,MN:MN:NI:NI:VA),,       +GFMN2NI2;,,                  N 10Liu !
