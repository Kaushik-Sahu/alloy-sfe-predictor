 PAR  G(FCC_4SL,MN:MN:CO:NI:VA),,       +FCOMN2NI;,,                 N 20Hal10 !
 PAR  G(FCC_4SL,NI:NI:CO:MN:VA),,       +FCOMNNI2;,,                 N 20Hal10 !
$
$ Metastable
$
 PAR  G(SIGMA_D8B,CO:NI:MN),,           +10*GHSERCO+4*GBCCNI
             +16*GBCCMN;,,                                            N Lin !
