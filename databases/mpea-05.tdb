$ ------------------------------------------------------------------------------
$ C
$
$ B2_BCC with Va on the substitutional sites and 1/3 Va on the interstitial
$ sites is more stable than liquid C. This only matters for metastable
$ calculations (i.e. without graphite). It is also more stable than alpha-Fe
$ + Fe3C below 700 K when the value 30*T is used. This value is further
$ increased.
$
 PAR  G(GRAPHITE_A9,C),,                +GHSERCC;,,                   N 91Din !
 PAR  G(DIAMOND_A4,C),,                 +GDIACC;,,                    N 91Din !
 PAR  G(LIQUID,C),,                     +GHSERCC+117369-24.63*T;,,    N 91Din !
$
 PAR  G(BCC_A2,VA:C),,                  +100000+30*T;,,              N 20Hal11 !
 PAR  G(A2_BCC,VA:C),,                  +100000+30*T;,,              N 20Hal11 !
$
